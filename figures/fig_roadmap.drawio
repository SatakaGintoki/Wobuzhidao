        </mxCell>

        <mxCell id="q1" value="&lt;b&gt;问题一&lt;/b&gt;&lt;br&gt;固定域 · 常物性&lt;br&gt;独立求解温度与含水率&lt;br&gt;附录2 · 0--1800 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F1;strokeColor=#2A9D8F;strokeWidth=2;fontColor=#164E63;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="190" width="200" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="q2" value="&lt;b&gt;问题二&lt;/b&gt;&lt;br&gt;固定域 · 变物性&lt;br&gt;联合热湿耦合求解&lt;br&gt;附录3 · 0--3 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F1;strokeColor=#2A9D8F;strokeWidth=2;fontColor=#164E63;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="190" width="200" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="q3" value="&lt;b&gt;问题三&lt;/b&gt;&lt;br&gt;全域达标事件&lt;br&gt;M(t)=max C(r,t) &lt; 0.15&lt;br&gt;长期环境延续 + 事件求根" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#E76F51;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="190" width="200" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="q4" value="&lt;b&gt;问题四&lt;/b&gt;&lt;br&gt;径向收缩 · 材料坐标&lt;br&gt;ξ = r / R(t)&lt;br&gt;附录4 · 动态边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#E76F51;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1">
