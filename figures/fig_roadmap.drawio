        </mxCell>

        <mxCell id="input" value="&lt;b&gt;统一输入&lt;/b&gt;&lt;br&gt;附件1：烘房环境 Ta(t), Ca(t)&lt;br&gt;附件2：半径轨迹 R(t)&lt;br&gt;附录2--4：物性关系" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A5F;fontSize=14;spacing=10;" vertex="1" parent="1">
